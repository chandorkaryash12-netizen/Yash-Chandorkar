<%- include('top') %>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header" id="top">
  <div class="container nav">
    <a class="brand" href="/" aria-label="<%= site.siteName %> home">
      <img src="<%= site.logo %>" alt="" width="44" height="44">
      <span class="brand-text"><strong><%= site.siteName %></strong><small><%= site.tagline %></small></span>
    </a>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" data-nav-toggle><span></span><span></span><span></span></button>
    <nav class="nav-links" data-nav>
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
      <div class="has-menu">
        <a href="/courses" class="<%= path.startsWith('/courses') ? 'active' : '' %>">Courses <span class="caret">▾</span></a>
        <div class="menu">
          <% navCourses.forEach(function (c) { %>
            <a href="/courses/<%= c.slug %>"><span class="menu-kicker"><%= c.category %></span><%= c.title %></a>
          <% }) %>
          <a href="/courses" class="menu-all">View all courses →</a>
        </div>
      </div>
      <a href="/research" class="<%= path.startsWith('/research') ? 'active' : '' %>">Research</a>
      <a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About</a>
      <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact</a>
      <span class="nav-sep"></span>
      <% if (currentUser) { %>
        <% if (currentUser.role === 'admin') { %><a href="/admin" class="btn btn-ghost btn-sm">Admin</a><% } %>
        <a href="/dashboard" class="btn btn-accent btn-sm">My dashboard</a>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-btn">Log out</button></form>
      <% } else { %>
        <a href="/login" class="nav-login">Log in</a>
        <a href="/signup" class="btn btn-accent btn-sm">Sign up</a>
      <% } %>
    </nav>
  </div>
</header>
<%- include('flash') %>
<main id="main">
