<%- include('_top') %>
<div class="toolbar"><p class="intro">Your products. Edit titles, pricing, curriculum, images and course materials. Drafts are hidden from the public site.</p><a href="/admin/courses/new" class="btn btn-accent">+ New course</a></div>
<div class="panel">
  <table class="table">
    <thead><tr><th>Course</th><th>Price</th><th>Students</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% courses.forEach(function (c, i) { %>
        <tr>
          <td class="with-thumb"><% if (c.image) { %><img src="<%= c.image %>" alt=""><% } %><div><a href="/admin/courses/<%= c.id %>"><strong><%= c.title %></strong></a><br><span class="small muted"><%= c.category %> · <%= c.modules.length %> modules</span></div></td>
          <td><%= h.formatINR(c.price) %><% if (c.originalPrice > c.price) { %><br><s class="small muted"><%= h.formatINR(c.originalPrice) %></s><% } %></td>
          <td><%= c.active %> active<% if (c.pending) { %><br><a class="small" href="/admin/enrollments?status=pending"><%= c.pending %> pending</a><% } %></td>
          <td><span class="status status-<%= c.published ? 'active' : 'pending' %>"><%= c.published ? 'Published' : 'Draft' %></span></td>
          <td class="actions">
            <form method="post" action="/admin/courses/<%= c.id %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="up"><button class="icon-btn" <%= i === 0 ? 'disabled' : '' %> title="Move up">↑</button></form>
            <form method="post" action="/admin/courses/<%= c.id %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="down"><button class="icon-btn" <%= i === courses.length - 1 ? 'disabled' : '' %> title="Move down">↓</button></form>
            <a href="/courses/<%= c.slug %>" target="_blank" class="btn btn-ghost btn-xs">View</a>
            <a href="/admin/courses/<%= c.id %>" class="btn btn-primary btn-xs">Edit</a>
          </td>
        </tr>
      <% }) %>
      <% if (!courses.length) { %><tr><td colspan="5" class="muted">No courses yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('_bottom') %>
