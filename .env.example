# Copy to .env (or set in your hosting dashboard)
PORT=3000
NODE_ENV=production
# First admin account (only used when no admin exists yet)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Yash Chandorkar
# Long random string used to sign login cookies
SESSION_SECRET=
# Where db.json and uploaded images are stored (use a persistent disk in production)
DATA_DIR=./data
# Optional: keep all data in MongoDB (needed on hosts without a persistent disk, e.g. Render Free)
MONGODB_URI=
